Preprocessing for pancreatic-islet scRNA-seq libraries generated with
Ficoll-based and gradient-free isolation workflows.

Expected input:
    data/ficoll_counts.h5ad
    data/gradient_free_counts.h5ad

Each input file should contain count-level gene-by-cell data in .X, or
in a layer named "counts". If ambient-RNA correction with CellBender was
performed before this step, use the CellBender-corrected count matrices
as these inputs.

Public workflow labels used throughout this repository:
    Ficoll
    Gradient-free

Main steps:
- sample-wise QC
- filtering: >=200 detected genes, >=500 total counts, <=10% mtRNA
- Scrublet doublet detection
- normalization to 10,000 counts/cell and log1p transformation
- initial broad clustering using 2,000 HVGs
- endocrine/exocrine subset
- repeated preprocessing of the subset using 3,000 HVGs
- scaling, PCA, Harmony integration, neighbors, UMAP, Leiden clustering
"""

from pathlib import Path

import anndata as ad
import scanpy as sc
import scanpy.external as sce


DATA_DIR = Path("data")
OUT_DIR = DATA_DIR / "processed"
OUT_DIR.mkdir(parents=True, exist_ok=True)

FICOLL_FILE = DATA_DIR / "ficoll_counts.h5ad"
GRADIENT_FREE_FILE = DATA_DIR / "gradient_free_counts.h5ad"
OUTPUT_FILE = OUT_DIR / "islets_preprocessed.h5ad"

MIN_GENES = 200
MIN_COUNTS = 500
MAX_MT_PERCENT = 10.0

NORMALIZATION_TARGET = 1e4

# Initial broad analysis
N_HVG_INITIAL = 2000
INITIAL_LEIDEN_RESOLUTION = 0.5

# Detailed endocrine/exocrine reanalysis
N_HVG_SUBSET = 3000
N_PCS = 50
N_NEIGHBORS = 30
N_PCS_NEIGHBORS = 30
SCALE_MAX_VALUE = 10
UMAP_MIN_DIST = 0.3
SUBSET_LEIDEN_RESOLUTIONS = (0.5, 1.0)

# Initial clusters retained in the endocrine/exocrine subset in the
# original analysis.
KEEP_CLUSTERS = {"0", "1", "3", "5", "6", "10", "13"}

RANDOM_STATE = 0


def get_counts(adata):
    """Return a copy of the raw/count-level matrix."""
    if "counts" in adata.layers:
        return adata.layers["counts"].copy()
    return adata.X.copy()


def load_library(path, workflow):
    """Load one library and attach a public workflow label."""
    if not path.exists():
        raise FileNotFoundError(
            f"Input file not found: {path}\n"
            "Place the count-level AnnData file at this path or edit "
            "FICOLL_FILE / GRADIENT_FREE_FILE at the top of the script."
        )

    adata = sc.read_h5ad(path)
    adata.var_names_make_unique()

    # Prefix barcodes so that they remain unique after concatenation.
    prefix = workflow.lower().replace("-", "_").replace(" ", "_")
    adata.obs_names = [f"{prefix}:{x}" for x in adata.obs_names]

    adata.obs["workflow"] = workflow
    adata.layers["counts"] = get_counts(adata)
    adata.X = adata.layers["counts"].copy()
    return adata


def add_qc_metrics(adata):
    """Calculate gene/count, mitochondrial, and ribosomal QC metrics."""
    adata.var["mt"] = adata.var_names.str.startswith("mt-")
    adata.var["ribo"] = (
        adata.var_names.str.startswith("Rps")
        | adata.var_names.str.startswith("Rpl")
    )

    sc.pp.calculate_qc_metrics(
        adata,
        qc_vars=["mt", "ribo"],
        percent_top=None,
        log1p=False,
        inplace=True,
    )


def filter_qc(adata):
    """Apply the QC thresholds used for the analysis."""
    keep = (
        (adata.obs["n_genes_by_counts"] >= MIN_GENES)
        & (adata.obs["total_counts"] >= MIN_COUNTS)
        & (adata.obs["pct_counts_mt"] <= MAX_MT_PERCENT)
    )
    return adata[keep].copy()


def run_scrublet(adata):
    """Detect putative doublets separately within each library."""
    sc.pp.scrublet(
        adata,
        expected_doublet_rate=0.05,
        sim_doublet_ratio=2.0,
        n_prin_comps=30,
        random_state=RANDOM_STATE,
    )

    if "predicted_doublet" not in adata.obs:
        raise RuntimeError(
            "Scrublet finished without creating 'predicted_doublet'."
        )

    adata.obs["scrublet_db"] = (
        adata.obs["predicted_doublet"].astype(bool)
    )

    return adata[~adata.obs["scrublet_db"]].copy()


def normalize_log(adata):
    """Restore counts, normalize to 10,000 counts/cell, and log1p."""
    adata.X = adata.layers["counts"].copy()

    sc.pp.normalize_total(
        adata,
        target_sum=NORMALIZATION_TARGET,
    )
    sc.pp.log1p(adata)

    adata.layers["lognorm"] = adata.X.copy()


def run_initial_analysis(adata):
    """
    Broad analysis used only to define the endocrine/exocrine subset.

    This function returns an HVG-restricted object, while the complete
    all-gene object is kept separately so that subset preprocessing can
    restart from the original counts.
    """
    work = adata.copy()

    sc.pp.highly_variable_genes(
        work,
        n_top_genes=N_HVG_INITIAL,
    )

    work = work[:, work.var["highly_variable"]].copy()

    sc.pp.scale(
        work,
        max_value=SCALE_MAX_VALUE,
    )

    sc.tl.pca(
        work,
        n_comps=N_PCS,
        svd_solver="arpack",
        random_state=RANDOM_STATE,
    )

    sc.pp.neighbors(
        work,
        n_neighbors=N_NEIGHBORS,
        n_pcs=N_PCS_NEIGHBORS,
        use_rep="X_pca",
        random_state=RANDOM_STATE,
    )

    sc.tl.umap(
        work,
        min_dist=UMAP_MIN_DIST,
        random_state=RANDOM_STATE,
    )

    sc.tl.leiden(
        work,
        resolution=INITIAL_LEIDEN_RESOLUTION,
        key_added="leiden_res0_5",
        random_state=RANDOM_STATE,
    )

    return work


def run_subset_analysis(adata):
    """Repeat preprocessing for the endocrine/exocrine subset."""
    normalize_log(adata)

    # Store the complete log-normalized matrix for marker/stress plots.
    adata.raw = adata.copy()

    sc.pp.highly_variable_genes(
        adata,
        n_top_genes=N_HVG_SUBSET,
        batch_key="workflow",
    )

    work = adata[:, adata.var["highly_variable"]].copy()

    sc.pp.scale(
        work,
        max_value=SCALE_MAX_VALUE,
    )

    sc.tl.pca(
        work,
        n_comps=N_PCS,
        svd_solver="arpack",
        random_state=RANDOM_STATE,
    )

    sce.pp.harmony_integrate(
        work,
        key="workflow",
        basis="X_pca",
        adjusted_basis="X_pca_harmony",
    )

    sc.pp.neighbors(
        work,
        n_neighbors=N_NEIGHBORS,
        n_pcs=N_PCS_NEIGHBORS,
        use_rep="X_pca_harmony",
        random_state=RANDOM_STATE,
    )

    sc.tl.umap(
        work,
        min_dist=UMAP_MIN_DIST,
        random_state=RANDOM_STATE,
    )

    for resolution in SUBSET_LEIDEN_RESOLUTIONS:
        key = "leiden_endo_exo_res" + str(resolution).replace(".", "_")
        sc.tl.leiden(
            work,
            resolution=resolution,
            key_added=key,
            random_state=RANDOM_STATE,
        )

    # Restore full log-normalized genes in .raw after HVG restriction.
    work.raw = adata.raw

    # Keep the count/lognorm matrices for the HVGs present in work.X.
    work.layers["counts"] = adata[
        :, work.var_names
    ].layers["counts"].copy()

    work.layers["lognorm"] = adata[
        :, work.var_names
    ].layers["lognorm"].copy()

    return work


# ---------------------------------------------------------------------
# Load and QC each library separately
# ---------------------------------------------------------------------

libraries = [
    load_library(FICOLL_FILE, "Ficoll"),
    load_library(GRADIENT_FREE_FILE, "Gradient-free"),
]

qc_libraries = []

for library in libraries:
    add_qc_metrics(library)
    library = filter_qc(library)
    library = run_scrublet(library)
    qc_libraries.append(library)


# Combine after sample-wise QC and doublet detection.
adata_all = ad.concat(
    qc_libraries,
    join="inner",
    merge="same",
)

adata_all.layers["counts"] = get_counts(adata_all)

print("Cells after QC and doublet removal:")
print(adata_all.obs["workflow"].value_counts())


# ---------------------------------------------------------------------
# Initial broad clustering
# ---------------------------------------------------------------------

normalize_log(adata_all)

adata_initial = run_initial_analysis(adata_all)

# Copy the initial cluster labels back to the complete all-gene object.
adata_all.obs["leiden_res0_5"] = (
    adata_initial.obs["leiden_res0_5"]
    .reindex(adata_all.obs_names)
    .astype(str)
)

print("\nInitial Leiden clusters:")
print(
    adata_all.obs["leiden_res0_5"]
    .value_counts()
    .sort_index()
)


# ---------------------------------------------------------------------
# Endocrine/exocrine subset from the complete count matrix
# ---------------------------------------------------------------------

subset_mask = (
    adata_all.obs["leiden_res0_5"]
    .astype(str)
    .isin(KEEP_CLUSTERS)
)

adata_subset_full = adata_all[subset_mask].copy()

# Restart the detailed analysis from raw counts, not from the initial
# 2,000-HVG matrix.
adata_subset_full.X = (
    adata_subset_full.layers["counts"].copy()
)

adata_final = run_subset_analysis(
    adata_subset_full
)

adata_final.write_h5ad(OUTPUT_FILE)

print(f"\nSaved: {OUTPUT_FILE}")
print(adata_final)
